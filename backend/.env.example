# Room server settings (all optional; these are the defaults).
# No secrets are needed in this milestone: the only LLM provider is the
# local fake.

PORT=4000
HOST=127.0.0.1

# Comma-separated origins allowed to call the server (the Next.js app).
CORS_ORIGIN=http://localhost:3000

LLM_PROVIDER=fake
# Fake provider latency multiplier: 2 = twice as fast.
FAKE_LLM_SPEED=1

MAX_ROOMS=200
LOG_LEVEL=info
