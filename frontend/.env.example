# Public, build-time settings. NEXT_PUBLIC_* values are inlined into the
# browser bundle — never put secrets here.

# Which backend "Enter The Room" uses: "mock" (default, fully local) or
# "live" (the room server in ../backend).
NEXT_PUBLIC_MEETING_BACKEND=mock

# Room server base URL, used when NEXT_PUBLIC_MEETING_BACKEND=live.
NEXT_PUBLIC_ROOM_SERVER_URL=http://localhost:4000
